function getRoleNav() {
  const role = currentUser?.role;
  if (role === 'Pharmacist') return NAV_PHARMACIST;
  if (role === 'Supplier') return NAV_SUPPLIER;
  return NAV_ALL;
}

function buildNav() {
  const nav = document.getElementById('sidebar-nav');
  if (!nav) return;
  const sections = getRoleNav();
  nav.innerHTML = sections.map(sec => `
    <div class="nav-section">
      <div class="nav-section-title">${sec.section}</div>
      ${sec.items.map(it => `
        <div class="nav-item" data-page="${it.id}" onclick="showPage('${it.id}',this)">
          <span class="nav-icon">${NAV_ICONS[it.id] || ''}</span>${it.label}
          ${it.badge ? `<span class="nav-badge" id="${it.badge}">0</span>` : ''}
        </div>`).join('')}
    </div>`).join('');
}

function navToAlerts() {
  const el = document.querySelector('[data-page="alerts"]');
  showPage('alerts', el);
  const dot = document.getElementById('notif-dot');
  if (dot) dot.style.display = 'none';
}

function navTo(pageId) {
  const el = document.querySelector(`[data-page="${pageId}"]`);
  showPage(pageId, el);
}

function showPage(id, el) {
  const allowed = getRoleNav().flatMap(s => s.items.map(i => i.id));
  if (!allowed.includes(id)) return;
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  const pg = document.getElementById('page-' + id);
  if (pg) pg.classList.add('active');
  if (el) el.classList.add('active');
  document.getElementById('page-title').textContent = pageTitles[id] || '';
  if (id === 'dashboard') renderDashboard();
  else if (id === 'users') renderUsers();
  else if (id === 'medicines') renderMeds();
  else if (id === 'batches') renderBatches();
  else if (id === 'alerts') renderAlerts();
  else if (id === 'suppliers') renderSuppliers();
  else if (id === 'purchase') renderPOs();
  else if (id === 'reports') setTimeout(renderWeeklyChart, 200);
}

