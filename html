function generateReport(type) {
  const fmt = document.getElementById('rpt-format').value;
  let rows = [], title = '';
  const today = new Date();

  if (type === 'expiry') {
    title = 'Expiry Report';
    sqlAll('SELECT b.*,m.threshold FROM batches b LEFT JOIN medicines m ON b.medicine_id=m.id ORDER BY b.expiry').forEach(b => {
      const diff = Math.ceil((new Date(b.expiry) - today) / 864e5);
      if (diff <= 30) rows.push({ Medicine:b.medicine, Batch:b.batch, Expiry:b.expiry, 'Days Left':diff<0?'EXPIRED':diff, Qty:b.qty, Supplier:b.supplier, Storage:b.storage });
    });
  } else if (type === 'stock') {
    title = 'Stock Summary';
    sqlAll('SELECT * FROM medicines ORDER BY name').forEach(m => {
      const tot = sqlAll('SELECT SUM(qty) as s FROM batches WHERE medicine_id=?',[m.id])[0]?.s || 0;
      const active = sqlAll('SELECT SUM(qty) as s FROM batches WHERE medicine_id=? AND expiry>=date("now")',[m.id])[0]?.s || 0;
      rows.push({ Medicine:m.name, Category:m.category, Unit:m.unit, Storage:m.storage, 'Total Qty':tot, 'Active Qty':active, Threshold:m.threshold, Status:active < m.threshold ? 'Low Stock' : 'OK', 'Price (₹)':m.price });
    });
  } else if (type === 'purchase') {
    title = 'Purchase Report';
    sqlAll('SELECT * FROM purchase_orders ORDER BY date DESC').forEach(po => {
      rows.push({ 'PO Number':po.po_number, Supplier:po.supplier, Items:po.items, 'Total (₹)':po.total, Status:po.status, Date:po.date });
    });
  } else if (type === 'usage') {
    title = 'Usage Report';
    ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].forEach((d,i) => rows.push({ Day:d, 'Units Issued':[65,88,72,95,80,58,70][i] }));
  } else if (type === 'audit') {
    title = 'Audit Report';
    sqlAll('SELECT * FROM batches ORDER BY id DESC').forEach(b => { rows.push({ Medicine:b.medicine, Batch:b.batch, 'Current Qty':b.qty, Expiry:b.expiry, Supplier:b.supplier }); });
  } else if (type === 'supplier') {
    title = 'Supplier Report';
    sqlAll('SELECT * FROM suppliers').forEach(s => { rows.push({ Supplier:s.name, Contact:s.contact, Email:s.email, City:s.city, 'Total Orders':s.orders, Rating:`${s.rating}/5`, Status:s.status }); });
  }

  if (!rows.length) { showToast('No data to export', ''); return; }
  if (fmt === 'CSV') downloadCSV(rows, title);
  else if (fmt === 'Excel') downloadExcel(rows, title);
  else downloadPDF(rows, title);
  closeModal();
  showToast(`${title} downloaded as ${fmt}!`, '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>');
}

function downloadCSV(rows, title) {
  const headers = Object.keys(rows[0]);
  const csv = [headers.join(','), ...rows.map(r => headers.map(h => `"${String(r[h]??'').replace(/"/g,'""')}"`).join(','))].join('\r\n');
  const blob = new Blob(['\uFEFF' + csv], { type:'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  triggerDownload(url, `${title.replace(/ /g,'_')}.csv`);
  setTimeout(() => URL.revokeObjectURL(url), 10000);
}

function downloadExcel(rows, title) {
  try {
    const ws = XLSX.utils.json_to_sheet(rows);
    ws['!cols'] = Object.keys(rows[0]).map(k => ({ wch:Math.max(k.length, 14) }));
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, title.slice(0,31));
    XLSX.writeFile(wb, `${title.replace(/ /g,'_')}.xlsx`);
  } catch(e) { downloadCSV(rows, title); }
}

function downloadPDF(rows, title) {
  const date = new Date().toLocaleDateString('en-IN');
  const headers = Object.keys(rows[0]);
  const thStyle = 'background:#1a6b4a;color:#fff;padding:10px 12px;text-align:left;font-size:12px;font-weight:700;';
  const tdBase = 'padding:9px 12px;border-bottom:1px solid #e2e8f0;font-size:12px;';
  const html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>${title}</title>
    <style>*{box-sizing:border-box;margin:0;padding:0;}body{font-family:Arial,sans-serif;padding:32px;}
    .hdr{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px;}
    .htitle{font-size:22px;font-weight:800;color:#1a6b4a;}.hsub{font-size:12px;color:#6b7280;}
    .print-btn{background:#1a6b4a;color:#fff;border:none;padding:9px 20px;border-radius:4px;font-size:13px;font-weight:700;cursor:pointer;}
    @media print{.no-print{display:none!important;}*{-webkit-print-color-adjust:exact;print-color-adjust:exact;}}
    </style></head><body>
    <div class="hdr"><div><div class="htitle">MediTrack — ${title}</div><div class="hsub">Generated ${date} · ${rows.length} records</div></div>
    <button class="print-btn no-print" onclick="window.print()"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg> Print / Save PDF</button></div>
    <table style="width:100%;border-collapse:collapse;">
      <thead><tr>${headers.map(h=>`<th style="${thStyle}">${h}</th>`).join('')}</tr></thead>
      <tbody>${rows.map((r,i)=>`<tr style="background:${i%2?'#f8faff':'#fff'}">${headers.map(h=>`<td style="${tdBase}">${r[h]??''}</td>`).join('')}</tr>`).join('')}</tbody>
    </table></body></html>`;
  const blob = new Blob([html], { type:'text/html;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const win = window.open(url, '_blank');
  if (!win) triggerDownload(url, `${title.replace(/ /g,'_')}.html`);
  setTimeout(() => URL.revokeObjectURL(url), 60000);
}

function triggerDownload(url, filename) {
  const a = document.createElement('a'); a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
}

