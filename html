// ═══════════════════════════════════════════════
// SQL.JS
// ═══════════════════════════════════════════════
let SQL, DB;
let _sqlReady = false;
let _sqlPromise = null;

function preloadSQL() {
  _sqlPromise = initSqlJs({ locateFile: f => `https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.10.2/${f}` })
    .then(sql => { SQL = sql; _sqlReady = true; })
    .catch(e => { console.error('SQL preload failed:', e); _sqlReady = false; });
  return _sqlPromise;
}
preloadSQL();

async function initSQL() {
  if (!_sqlReady && _sqlPromise) await _sqlPromise;
  if (!SQL) {
    SQL = await initSqlJs({ locateFile: f => `https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.10.2/${f}` });
  }
  if (DB) return;
  const saved = localStorage.getItem('meditrack_db_v4');
  if (saved) {
    const buf = Uint8Array.from(atob(saved), c => c.charCodeAt(0));
    DB = new SQL.Database(buf);
  } else {
    DB = new SQL.Database();
    createSchema();
    seedData();
    saveDB();
  }
  // Migration: add barcode column if missing
  try { DB.run("ALTER TABLE medicines ADD COLUMN barcode TEXT"); saveDB(); } catch(e) {}
}

function saveDB() {
  const data = DB.export();
  const b64 = btoa(String.fromCharCode(...data));
  try { localStorage.setItem('meditrack_db_v4', b64); } catch(e) {}
}

function createSchema() {
  DB.run(`
    CREATE TABLE IF NOT EXISTS users(id INTEGER PRIMARY KEY AUTOINCREMENT,name TEXT,email TEXT,role TEXT,status TEXT,phone TEXT,avatar TEXT);
    CREATE TABLE IF NOT EXISTS medicines(id INTEGER PRIMARY KEY AUTOINCREMENT,name TEXT,category TEXT,unit TEXT,storage TEXT,threshold INTEGER DEFAULT 50,price REAL DEFAULT 0,status TEXT DEFAULT 'Active',barcode TEXT);
    CREATE TABLE IF NOT EXISTS batches(id INTEGER PRIMARY KEY AUTOINCREMENT,medicine_id INTEGER,medicine TEXT,batch TEXT,expiry TEXT,qty INTEGER,supplier TEXT,storage TEXT);
    CREATE TABLE IF NOT EXISTS suppliers(id INTEGER PRIMARY KEY AUTOINCREMENT,name TEXT,contact TEXT,email TEXT,city TEXT,orders INTEGER DEFAULT 0,rating INTEGER DEFAULT 5,status TEXT);
    CREATE TABLE IF NOT EXISTS purchase_orders(id INTEGER PRIMARY KEY AUTOINCREMENT,po_number TEXT,supplier TEXT,items INTEGER,total REAL,status TEXT,date TEXT);
  `);
}

function sqlAll(q, p = []) {
  try {
    const s = DB.prepare(q); s.bind(p);
    const r = [];
    while (s.step()) r.push(s.getAsObject());
    s.free(); return r;
  } catch(e) { console.error(e, q); return []; }
}
function sqlRun(q, p = []) { try { DB.run(q, p); } catch(e) { console.error(e); } saveDB(); }
function sqlOne(q, p = []) { return sqlAll(q, p)[0] || null; }

function daysFromNow(n) {
  const d = new Date(); d.setDate(d.getDate() + n);
  return d.toISOString().split('T')[0];
}

