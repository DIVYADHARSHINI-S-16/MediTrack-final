function renderWeeklyChart() {
  const vals = [65,88,72,95,80,58,70];
  const days = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
  const clrs = ['#1a6b4a','#1a55a0','#9a6800','#c0392b','#2e7d6b','#5a4a1a','#4a6b1a'];
  const mx = Math.max(...vals);
  document.getElementById('wk-chart').innerHTML = days.map((day, i) => `
    <div class="wk-col">
      <div class="wk-bar" data-v="${vals[i]}" style="height:${(vals[i]/mx*88)}px;background:${clrs[i]};"></div>
      <span class="wk-lbl">${day}</span>
    </div>`).join('');
}

