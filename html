// ── PO Items ──
function updatePOTotal() {
  let total = 0;
  document.querySelectorAll('#po-items > div').forEach(row => {
    const qty = parseFloat(row.querySelector('.po-qty')?.value) || 0;
    const price = parseFloat(row.querySelector('.po-price')?.value) || 0;
    total += qty * price;
  });
  const el = document.getElementById('po-total-display');
  if (el) el.textContent = '₹' + total.toFixed(2);
}

function buildMedOptions(selectedName) {
  const meds = sqlAll('SELECT name,price FROM medicines ORDER BY name');
  return meds.map(m => `<option data-price="${m.price}" ${m.name===selectedName?'selected':''}>${m.name}</option>`).join('');
}

function addPOItem() {
  const c = document.getElementById('po-items');
  if (!c) return;
  const row = document.createElement('div');
  row.style.cssText = 'display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:8px;margin-bottom:8px;animation:rowFade 0.25s ease;';
  row.innerHTML = `<select class="po-med">${buildMedOptions()}</select>
    <input type="number" class="po-qty" placeholder="Qty" min="1">
    <input type="number" class="po-price" placeholder="₹ Price" step="0.01">
    <button class="btn btn-danger btn-sm btn-icon" onclick="this.closest('div').remove();updatePOTotal()" style="align-self:center;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>`;
  c.appendChild(row);
  const sel = row.querySelector('.po-med');
  const priceEl = row.querySelector('.po-price');
  function fillPrice() {
    const opt = sel.options[sel.selectedIndex];
    if (priceEl && opt && opt.dataset.price) priceEl.value = parseFloat(opt.dataset.price).toFixed(2);
    updatePOTotal();
  }
  sel.addEventListener('change', fillPrice);
  row.querySelector('.po-qty').addEventListener('input', updatePOTotal);
  priceEl.addEventListener('input', updatePOTotal);
  fillPrice();
}

function savePO() {
  const supplier = document.getElementById('f-po-supplier')?.value;
  if (!supplier) { showToast('Select a supplier', ''); return; }
  const rows = [...document.querySelectorAll('#po-items > div')];
  let total = 0, itemCount = 0;
  rows.forEach(row => {
    const qty = parseFloat(row.querySelector('.po-qty')?.value) || 0;
    const price = parseFloat(row.querySelector('.po-price')?.value) || 0;
    if (qty > 0) { total += qty * price; itemCount++; }
  });
  if (itemCount === 0) { showToast('Add at least one item with a quantity', ''); return; }
  const existing = sqlAll('SELECT po_number FROM purchase_orders ORDER BY id DESC');
  let nextNum = 1;
  if (existing.length) {
    const last = existing[0].po_number;
    const parts = last.split('-');
    nextNum = (parseInt(parts[parts.length-1]) || 0) + 1;
  }
  const year = new Date().getFullYear();
  const poNum = `PO-${year}-${String(nextNum).padStart(3,'0')}`;
  const today = new Date().toISOString().split('T')[0];
  sqlRun('INSERT INTO purchase_orders(po_number,supplier,items,total,status,date) VALUES(?,?,?,?,?,?)', [poNum,supplier,itemCount,Math.round(total),'Pending',today]);
  sqlRun('UPDATE suppliers SET orders=orders+1 WHERE name=?', [supplier]);
  showToast(`${poNum} created!`, '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>');
  closeModal();
  if (document.getElementById('page-purchase')?.classList.contains('active')) renderPOs();
  if (document.getElementById('page-suppliers')?.classList.contains('active')) renderSuppliers();
  renderDashboard();
}

