function issueMed() {
  const mid = parseInt(document.getElementById('f-imed').value);
  const qty = parseInt(document.getElementById('f-iqty').value) || 0;
  if (!mid || qty < 1) { showToast('Select medicine and quantity', ''); return; }
  const batches = sqlAll('SELECT * FROM batches WHERE medicine_id=? AND qty>0 AND expiry>=date("now") ORDER BY expiry ASC', [mid]);
  let remaining = qty;
  for (const b of batches) {
    if (remaining <= 0) break;
    const take = Math.min(b.qty, remaining);
    sqlRun('UPDATE batches SET qty=qty-? WHERE id=?', [take, b.id]);
    remaining -= take;
  }
  if (remaining > 0) showToast(`Only ${qty - remaining} units available (partial issue)!`, '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>');
  else showToast(`${qty} units issued via FIFO`, '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>');
  closeModal(); renderBatches(); renderDashboard();
}

