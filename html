  });
  document.getElementById('bc-result').style.display = 'none';
  document.getElementById('bc-use-btn').style.display = 'none';
  if (tab==='camera') bcStartCamera(); else bcStopCamera();
}

// ── Camera scanning (jsQR via requestAnimationFrame) ──
async function bcStartCamera() {
  const video = document.getElementById('bc-video');
  const status = document.getElementById('bc-cam-status');
  if (!video) return;
  if (!navigator.mediaDevices?.getUserMedia) { bcShowCameraError('Camera API not available in this browser.'); return; }
  try {
    _bcStream = await navigator.mediaDevices.getUserMedia({ video:{ facingMode:'environment' } });
    video.srcObject = _bcStream;
    video.onloadedmetadata = () => { video.play(); bcScanLoop(); };
    if (status) status.textContent = 'Camera active — hold QR code steady';
  } catch(e) {
    let msg = /Permission|denied/i.test(e.message) ? 'Camera permission denied. Use "Upload Image" or "Manual Entry".'
            : /not found|no device/i.test(e.message) ? 'No camera found on this device.'
            : e.message;
    bcShowCameraError(msg);
  }
}

function bcScanLoop() {
  const video  = document.getElementById('bc-video');
  const canvas = document.getElementById('bc-canvas');
  if (!video || !canvas || !_bcStream) return;
  if (video.readyState < 2) { _bcAnimFrame = requestAnimationFrame(bcScanLoop); return; }
  canvas.width  = video.videoWidth;
  canvas.height = video.videoHeight;
  const ctx = canvas.getContext('2d');
  ctx.drawImage(video, 0, 0);
  const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
  if (typeof jsQR !== 'undefined') {
    const code = jsQR(imgData.data, imgData.width, imgData.height, { inversionAttempts:'dontInvert' });
    if (code?.data) {
      bcStopCamera();
      bcProcessCode(code.data);
      return;
    }
  }
  _bcAnimFrame = requestAnimationFrame(bcScanLoop);
}

function bcStopCamera() {
  if (_bcAnimFrame) { cancelAnimationFrame(_bcAnimFrame); _bcAnimFrame = null; }
  if (_bcStream) { _bcStream.getTracks().forEach(t => t.stop()); _bcStream = null; }
  const video = document.getElementById('bc-video');
  if (video) { video.srcObject = null; }
}

function bcShowCameraError(msg) {
  const panel = document.getElementById('bc-panel-camera');
  if (!panel) return;
  panel.innerHTML = `<div style="padding:24px;text-align:center;color:var(--text2);">
    <div style="margin-bottom:10px;color:var(--text3);">${IC_CAM.replace('14','28').replace('14','28')}</div>
    <div style="font-size:13px;font-weight:600;margin-bottom:6px;">Camera unavailable</div>
    <div style="font-size:11.5px;color:var(--text3);margin-bottom:14px;">${msg}</div>
    <div style="display:flex;gap:8px;justify-content:center;">
      <button class="btn btn-outline" onclick="bcSwitchTab('upload')" style="font-size:12px;">${IC_IMG} Upload Image</button>
      <button class="btn btn-outline" onclick="bcSwitchTab('manual')" style="font-size:12px;">${IC_KEY} Manual Entry</button>
    </div>
  </div>`;
}

// ── Image upload decode ───────────────────────────
function bcHandleFile(file) {
  if (!file) return;
  const preview = document.getElementById('bc-upload-preview');
  const img     = document.getElementById('bc-preview-img');
  const status  = document.getElementById('bc-upload-status');
  const drop    = document.getElementById('bc-drop');

  const reader = new FileReader();
  reader.onload = (e) => {
    img.src = e.target.result;
    preview.style.display = 'block';
    drop.style.display = 'none';
    if (status) status.textContent = 'Scanning image…';

    const image = new Image();
    image.onload = () => {
      const canvas = document.createElement('canvas');
      canvas.width  = image.width;
      canvas.height = image.height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(image, 0, 0);
      const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);

      let code = null;
      if (typeof jsQR !== 'undefined') {
        code = jsQR(imageData.data, imageData.width, imageData.height, { inversionAttempts:'attemptBoth' });
      }
      if (code?.data) {
        if (status) status.textContent = 'QR code detected: ' + code.data;
        bcProcessCode(code.data);
      } else {
        if (status) status.innerHTML = '<span style="color:var(--red);">No QR code detected in image. Try a clearer photo or use Manual Entry.</span>';
        document.getElementById('bc-result').style.display = 'none';
      }
    };
    image.src = e.target.result;
  };
  reader.readAsDataURL(file);
}

function bcClose() { bcStopCamera(); closeModal(); }

// ── Process decoded code ──────────────────────────
async function bcProcessCode(code) {
  code = (code || '').trim();
  if (!code) { showToast('No code detected'); return; }
  _bcLastCode = code;
  document.getElementById('bc-thinking').style.display = 'flex';
  document.getElementById('bc-result').style.display = 'none';
  document.getElementById('bc-use-btn').style.display = 'none';

  // Check existing inventory first
  const existing = sqlOne('SELECT * FROM medicines WHERE barcode=?', [code]);
  if (existing) {
    document.getElementById('bc-thinking').style.display = 'none';
    _bcLastMed = existing;
    bcShowResult({ found:true, name:existing.name, category:existing.category, unit:existing.unit, storage:existing.storage, barcode:code, note:'Already in inventory' });
    return;
  }

  // AI lookup
  document.getElementById('bc-thinking-msg').textContent = 'Looking up with AI…';
  try {
    const prompt = `Medicine barcode: "${code}". Identify if pharmaceutical. Return ONLY JSON: {"name":"","category":"Analgesics|Antibiotics|Antidiabetics|Antacids|Cardiovascular|Respiratory|Vitamins|Neurological|Other","unit":"Tablet|Capsule|Syrup|Injection|Vial|Inhaler|Cream|Drops","storage":"Room Temp|Refrigerated|Frozen","threshold":50,"price":0,"confidence":"high|medium|low","notes":""}`;
    const text = await callClaude(prompt, 'Pharmaceutical database AI. Return valid JSON only, no markdown.');
    const parsed = JSON.parse(text.replace(/```json|```/g,'').trim());
    parsed.barcode = code;
    _bcLastMed = parsed;
    document.getElementById('bc-thinking').style.display = 'none';
    bcShowResult({ found:false, ...parsed });
  } catch(e) {
    document.getElementById('bc-thinking').style.display = 'none';
    bcShowResult({ found:false, name:'Unknown', barcode:code, confidence:'low', notes:'Could not identify barcode' });
  }
}

