// ── Tab switcher ──────────────────────────────────
function bcSwitchTab(tab) {
  ['camera','upload','manual'].forEach(t => {
    document.getElementById(`bc-tab-${t}`)?.classList.toggle('active', t===tab);
    const p = document.getElementById(`bc-panel-${t}`);
