// ═══════════════════════════════════════════════
// AI FEATURES
// ═══════════════════════════════════════════════
async function callClaude(messages, systemPrompt, imageBase64=null, mimeType='image/jpeg') {
  const msgContent = [];
  if (imageBase64) msgContent.push({ type:'image', source:{ type:'base64', media_type:mimeType, data:imageBase64 } });
  msgContent.push({ type:'text', text:messages });
  const resp = await fetch('https://api.anthropic.com/v1/messages', {
    method:'POST',
    headers:{ 'Content-Type':'application/json' },
    body:JSON.stringify({ model:'claude-sonnet-4-20250514', max_tokens:1000, system:systemPrompt, messages:[{ role:'user', content:msgContent }] })
  });
  const data = await resp.json();
  if (data.error) throw new Error(data.error.message);
  return data.content?.[0]?.text || '';
}

function fillMedFormFromAI(parsed) {
  const cats = ['Analgesics','Antibiotics','Antidiabetics','Antacids','Cardiovascular','Respiratory','Vitamins','Neurological','Other'];
  if (parsed.name) { const el=document.getElementById('f-mname'); if(el) el.value=parsed.name; }
  if (parsed.category) { const el=document.getElementById('f-mcat'); if(el) { for(let i=0;i<el.options.length;i++) if(el.options[i].value===parsed.category||el.options[i].text===parsed.category){el.selectedIndex=i;break;} } }
  if (parsed.unit) { const el=document.getElementById('f-munit'); if(el) { for(let i=0;i<el.options.length;i++) if(el.options[i].text.toLowerCase()===parsed.unit.toLowerCase()){el.selectedIndex=i;break;} } }
