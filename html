<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MediTrack – Medicine Management System</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.10.2/sql-wasm.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
:root {
 --font: 'DM Sans', sans-serif;
 --mono: 'IBM Plex Mono', monospace;
 --r: 2px;
 --accent: #1a6b4a;
 --accent-dk: #145538;
 --accent-lt: #e8f5ef;
 --accent-mid: rgba(26,107,74,0.12);
 --red: #c0392b;
 --amber: #9a6800;
 --green: #1a6b4a;
 --blue: #1a55a0;
 --sb-bg: #0f1923;
 --sb-border: #1e2d3d;
 --sb-text: #7a94aa;
 --sb-active: #fff;
 --sb-hover: #1a2840;
 --sb-pill: #1a3050;
 /* Alias vars used throughout JS-generated HTML */
 --primary:   #1a6b4a;
 --secondary: #1a55a0;
 --success:   #1a6b4a;
 --warning:   #9a6800;
 --danger:    #c0392b;
}
[data-theme="light"], :root {
 --bg: #f2f4f7; --bg2: #ffffff; --bg3: #e8ecf1; --bg4: #d8dde6;
 --text: #0f1923; --text2: #4a5a6a; --text3: #8a9aaa;
 --border: #dde1e8; --border2: #c8cdd8; --card: #ffffff; --inp: #ffffff;
 --topbar: #ffffff; --shadow: 0 1px 3px rgba(0,0,0,0.09);
}
[data-theme="dark"] {
 --bg: #0c1118; --bg2: #111923; --bg3: #18232f; --bg4: #1e2d3c;
 --text: #e0e8f0; --text2: #7a94aa; --text3: #3d5570;
 --border: #1e2d3c; --border2: #28394d; --card: #111923; --inp: rgba(255,255,255,0.05);
 --topbar: #0f1923; --shadow: 0 2px 8px rgba(0,0,0,0.4);
 --accent-lt: rgba(26,107,74,0.15); --accent-mid: rgba(26,107,74,0.2);
}
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html, body { height:100%; scroll-behavior:smooth; font-size:14px; -webkit-text-size-adjust:100%; }
body { font-family:var(--font); background:var(--bg); color:var(--text); height:100%; overflow:hidden; transition:background 0.2s,color 0.2s; -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }
.app { display:flex; height:100vh; overflow:hidden; }
.sidebar { width:220px; background:var(--sb-bg); border-right:1px solid var(--sb-border); position:fixed; top:0; left:0; height:100vh; display:flex; flex-direction:column; z-index:200; }
.sidebar-logo { padding:16px 14px; border-bottom:1px solid var(--sb-border); display:flex; align-items:center; gap:10px; }
.logo-mark { width:30px; height:30px; background:var(--accent); display:flex; align-items:center; justify-content:center; flex-shrink:0; border-radius:var(--r); }
.logo-text { font-size:15px; font-weight:700; color:#fff; letter-spacing:-0.2px; line-height:1.1; }
.logo-sub { font-size:9.5px; color:var(--sb-text); margin-top:2px; letter-spacing:0.3px; }
.sidebar-nav { padding:8px 6px; flex:1; overflow-y:auto; }
.sidebar-nav::-webkit-scrollbar { display:none; }
.nav-section { margin-bottom:2px; }
.nav-section-title { font-size:9px; font-weight:600; color:var(--sb-text); text-transform:uppercase; letter-spacing:1.6px; padding:10px 10px 4px; }
.nav-item { display:flex; align-items:center; gap:8px; padding:7px 10px; border-radius:var(--r); cursor:pointer; color:var(--sb-text); font-size:12.5px; font-weight:400; margin-bottom:1px; transition:background 0.1s,color 0.1s; position:relative; }
.nav-item:hover { background:var(--sb-hover); color:var(--sb-active); }
.nav-item.active { background:var(--sb-pill); color:var(--sb-active); font-weight:500; }
.nav-item.active::before { content:''; position:absolute; left:0; top:4px; bottom:4px; width:2px; background:var(--accent); border-radius:0 1px 1px 0; }
.nav-icon { font-size:13px; width:16px; text-align:center; flex-shrink:0; opacity:0.85; }
.nav-badge { margin-left:auto; background:var(--red); color:#fff; font-size:9.5px; font-weight:700; font-family:var(--mono); min-width:16px; height:16px; border-radius:2px; display:flex; align-items:center; justify-content:center; padding:0 3px; }
.user-card { display:flex; align-items:center; gap:9px; padding:9px 10px; background:var(--sb-hover); border-radius:var(--r); }
.user-avatar { width:28px; height:28px; border-radius:50%; background:var(--accent); color:#fff; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; flex-shrink:0; }
.user-name { font-size:12px; font-weight:600; color:#fff; line-height:1.2; }
.user-role { font-size:10px; color:var(--sb-text); margin-top:1px; }
.sidebar-footer { padding:10px 8px; border-top:1px solid var(--sb-border); }
.main { margin-left:220px; width:calc(100vw - 220px); display:flex; flex-direction:column; height:100vh; overflow:hidden; }
.topbar { height:48px; flex-shrink:0; background:var(--topbar); border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; padding:0 18px; z-index:100; transition:background 0.2s,border-color 0.2s; }
.page-title { font-size:13px; font-weight:600; color:var(--text); }
.topbar-actions { display:flex; align-items:center; gap:5px; }
.topbar-btn { width:30px; height:30px; border-radius:var(--r); background:transparent; border:1px solid var(--border); display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:13px; color:var(--text2); transition:background 0.1s,color 0.1s; position:relative; }
.topbar-btn:hover { background:var(--bg3); color:var(--text); }
.notif-dot { position:absolute; top:4px; right:4px; width:5px; height:5px; border-radius:50%; background:var(--red); border:1.5px solid var(--topbar); }
.content { flex:1; padding:16px 18px; overflow-y:auto; overflow-x:hidden; min-height:0; }
.page { display:none; }
.page.active { display:block; animation:pageIn 0.18s ease; padding-bottom:24px; }
@keyframes pageIn { from{opacity:0;transform:translateY(6px);} to{opacity:1;transform:none;} }
.stats-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-bottom:14px; width:100%; }
.stat-card { background:var(--card); border:1px solid var(--border); border-radius:var(--r); padding:14px 16px; transition:border-color 0.12s; }
.stat-card:hover { border-color:var(--accent); }
.stat-icon { width:32px; height:32px; margin-bottom:10px; display:flex; align-items:center; justify-content:center; border-radius:var(--r); flex-shrink:0; }
.stat-card.blue  .stat-icon { background:rgba(26,107,74,0.1); color:var(--accent); }
.stat-card.green .stat-icon { background:rgba(26,107,74,0.1); color:var(--green); }
.stat-card.yellow .stat-icon { background:rgba(154,104,0,0.1); color:var(--amber); }
.stat-card.red   .stat-icon { background:rgba(192,57,43,0.1); color:var(--red); }
.stat-val { font-size:26px; font-weight:700; line-height:1; margin-bottom:3px; font-family:var(--mono); color:var(--text); transition:color 0.2s; }
.stat-val.flash { animation:numFlash 0.3s ease; }
@keyframes numFlash { 0%{color:var(--accent);} 100%{color:var(--text);} }
.stat-label { font-size:11.5px; color:var(--text2); font-weight:500; }
.stat-change { font-size:10.5px; margin-top:5px; color:var(--text3); }
.stat-card.blue { border-left:3px solid var(--accent); }
.stat-card.green { border-left:3px solid var(--green); }
.stat-card.yellow { border-left:3px solid var(--amber); }
.stat-card.red { border-left:3px solid var(--red); }
.progress-bar { height:3px; background:var(--bg3); border-radius:1px; overflow:hidden; margin-top:9px; }
.progress-fill { height:100%; transition:width 0.8s ease; border-radius:1px; }
.card { background:var(--card); border:1px solid var(--border); border-radius:var(--r); overflow:hidden; margin-bottom:12px; }
.card-header { padding:10px 14px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; background:var(--bg3); flex-wrap:wrap; gap:8px; }
.card-title { font-size:12px; font-weight:600; display:flex; align-items:center; gap:7px; color:var(--text); }
.card-body { padding:14px; }
.btn { padding:6px 13px; border-radius:var(--r); border:none; cursor:pointer; font-size:12px; font-weight:600; display:inline-flex; align-items:center; gap:4px; transition:background 0.12s,opacity 0.12s; font-family:var(--font); white-space:nowrap; }
.btn:active { opacity:0.8; }
.btn-primary { background:var(--accent); color:#fff; }
.btn-primary:hover { background:var(--accent-dk); }
.btn-success { background:var(--green); color:#fff; }
.btn-success:hover { background:#145538; }
.btn-danger { background:var(--red); color:#fff; }
.btn-danger:hover { background:#a93226; }
.btn-warning { background:var(--amber); color:#fff; }
.btn-outline { background:transparent; border:1px solid var(--border); color:var(--text2); }
.btn-outline:hover { border-color:var(--accent); color:var(--accent); background:var(--accent-lt); }
.btn-sm { padding:4px 10px; font-size:11px; }
.btn-icon { width:28px; height:28px; padding:0; justify-content:center; flex-shrink:0; }
.btn-icon svg { pointer-events:none; display:block; }
.table-wrap { overflow-x:auto; }
table { width:100%; border-collapse:collapse; }
th { padding:8px 12px; text-align:left; font-size:10px; font-weight:700; color:var(--text2); text-transform:uppercase; letter-spacing:0.9px; background:var(--bg3); border-bottom:2px solid var(--border); }
td { padding:10px 12px; font-size:12.5px; text-align:left; border-bottom:1px solid var(--border); vertical-align:middle; }
tr:last-child td { border-bottom:none; }
tbody tr { transition:background 0.08s; }
tbody tr:hover td { background:var(--bg3); }
.badge { padding:1px 7px; border-radius:2px; font-size:10px; font-weight:600; font-family:var(--mono); display:inline-flex; align-items:center; text-transform:uppercase; letter-spacing:0.5px; border:1px solid; }
.badge-success { background:rgba(26,107,74,0.08); color:var(--green); border-color:rgba(26,107,74,0.2); }
.badge-warning { background:rgba(154,104,0,0.08); color:var(--amber); border-color:rgba(154,104,0,0.2); }
.badge-danger { background:rgba(192,57,43,0.08); color:var(--red); border-color:rgba(192,57,43,0.2); }
.badge-info { background:rgba(26,85,160,0.08); color:var(--blue); border-color:rgba(26,85,160,0.2); }
.badge-purple { background:rgba(90,60,190,0.07); color:#5a3cbe; border-color:rgba(90,60,190,0.18); }
.badge-gray { background:var(--bg3); color:var(--text2); border-color:var(--border); }
.form-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.form-group { display:flex; flex-direction:column; gap:4px; }
.form-group.full { grid-column:1/-1; }
label { font-size:10.5px; font-weight:600; color:var(--text2); letter-spacing:0.2px; }
input, select, textarea { background:var(--inp); border:1px solid var(--border); border-radius:var(--r); padding:8px 10px; color:var(--text); font-size:12.5px; font-family:var(--font); transition:border-color 0.12s; outline:none; }
input:focus, select:focus, textarea:focus { border-color:var(--accent); }
select option { background:var(--bg2); color:var(--text); }
.search-box { position:relative; display:flex; align-items:center; }
.search-box input { padding-left:30px; width:210px; }
.search-icon { position:absolute; left:9px; color:var(--text3); font-size:12px; pointer-events:none; }
.tabs { display:flex; gap:0; border-bottom:1px solid var(--border); margin-bottom:12px; }
.tab { padding:7px 14px; font-size:12px; font-weight:500; cursor:pointer; color:var(--text2); transition:color 0.12s; border-bottom:2px solid transparent; margin-bottom:-1px; }
.tab.active { color:var(--accent); border-bottom-color:var(--accent); font-weight:600; }
.tab:hover:not(.active) { color:var(--text); }
.modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:1000; display:none; align-items:center; justify-content:center; }
.modal-overlay.open { display:flex; animation:fadeIn 0.12s ease; }
@keyframes fadeIn { from{opacity:0;} to{opacity:1;} }
.modal { background:var(--card); border:1px solid var(--border2); border-radius:var(--r); width:560px; max-width:96vw; max-height:90vh; overflow-y:auto; animation:modalIn 0.18s ease; box-shadow:0 10px 40px rgba(0,0,0,0.25); }
@keyframes modalIn { from{transform:translateY(-10px);opacity:0;} to{transform:none;opacity:1;} }
.modal-header { padding:14px 18px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; background:var(--bg3); }
.modal-title { font-size:13px; font-weight:700; }
.modal-close { width:26px; height:26px; border-radius:var(--r); background:var(--bg4); border:none; cursor:pointer; color:var(--text2); font-size:13px; display:flex; align-items:center; justify-content:center; transition:background 0.12s; }
.modal-close:hover { background:rgba(192,57,43,0.12); color:var(--red); }
.modal-body { padding:18px; }
.modal-footer { padding:12px 18px; border-top:1px solid var(--border); display:flex; gap:7px; justify-content:flex-end; }
.alert-item { display:flex; align-items:flex-start; gap:10px; padding:10px 12px; margin-bottom:6px; border-left:2px solid; background:var(--bg3); border-radius:0 var(--r) var(--r) 0; }
.alert-item.danger { border-left-color:var(--red); }
.alert-item.warning { border-left-color:var(--amber); }
.alert-item.info { border-left-color:var(--blue); }
.alert-icon { font-size:14px; flex-shrink:0; margin-top:1px; }
.alert-info { flex:1; }
.alert-title { font-size:12px; font-weight:600; margin-bottom:1px; }
.alert-desc { font-size:11px; color:var(--text2); line-height:1.5; }
.alert-time { font-size:10px; color:var(--text3); white-space:nowrap; }
.chart-row { display:flex; align-items:center; gap:9px; margin-bottom:8px; }
.chart-label { width:110px; font-size:11px; color:var(--text2); text-align:right; flex-shrink:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.chart-bar-wrap { flex:1; }
.chart-val { width:38px; font-size:11px; font-weight:700; text-align:right; font-family:var(--mono); }
.grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.grid-3 { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
.grid-4 { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; }
.donut-wrap { position:relative; width:130px; height:130px; margin:0 auto 16px; }
svg.donut { transform:rotate(-90deg); overflow:visible; display:block; }
svg.donut circle { transition:stroke-dasharray 0.55s ease,stroke-dashoffset 0.55s ease,opacity 0.2s,stroke-width 0.15s; }
.donut-center { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; cursor:pointer; }
.donut-val { font-size:22px; font-weight:700; font-family:var(--mono); line-height:1; }
.donut-sub { font-size:9px; color:var(--text2); margin-top:3px; }
.wk-chart { display:flex; align-items:flex-end; gap:5px; height:90px; padding:0 4px; }
.wk-col { flex:1; display:flex; flex-direction:column; align-items:center; gap:4px; justify-content:flex-end; height:100%; }
.wk-bar { width:100%; min-height:3px; border-radius:1px 1px 0 0; cursor:pointer; transition:opacity 0.1s; position:relative; }
.wk-bar:hover { opacity:0.7; }
.wk-bar::after { content:attr(data-v); position:absolute; top:-16px; left:50%; transform:translateX(-50%); font-size:9px; color:var(--text2); opacity:0; transition:opacity 0.1s; white-space:nowrap; font-family:var(--mono); }
.wk-bar:hover::after { opacity:1; }
.wk-lbl { font-size:9.5px; color:var(--text2); }
.live-pill { display:inline-flex; align-items:center; gap:4px; font-size:9px; font-weight:700; padding:2px 6px; border-radius:2px; background:rgba(26,107,74,0.08); border:1px solid rgba(26,107,74,0.2); color:var(--green); letter-spacing:0.5px; text-transform:uppercase; font-family:var(--mono); }
.live-dot { width:4px; height:4px; border-radius:50%; background:var(--green); animation:blink 1.4s infinite; }
@keyframes blink { 0%,100%{opacity:1;} 50%{opacity:0.2;} }
.cat-pill { background:var(--card); border:1px solid var(--border); border-radius:var(--r); padding:10px; text-align:center; transition:border-color 0.12s; cursor:pointer; }
.cat-pill:hover { border-color:var(--accent); }
.cat-pill-val { font-size:16px; font-weight:700; font-family:var(--mono); }
.cat-pill-lbl { font-size:10px; color:var(--text2); margin-top:2px; }
.po-status-bar { display:flex; margin:14px 0; }
.po-step { flex:1; text-align:center; position:relative; }
.po-step::before { content:''; position:absolute; top:12px; left:50%; right:-50%; height:1px; background:var(--border); }
.po-step:last-child::before { display:none; }
.po-dot { width:26px; height:26px; border-radius:50%; background:var(--bg3); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; margin:0 auto 6px; font-size:11px; position:relative; z-index:1; transition:all 0.25s; }
.po-step.done .po-dot { background:var(--green); border-color:var(--green); color:#fff; }
.po-step.active .po-dot { background:var(--accent); border-color:var(--accent); color:#fff; }
.po-step-label { font-size:10px; color:var(--text2); }
.po-step.done .po-step-label, .po-step.active .po-step-label { color:var(--text); }
.report-card { background:var(--card); border:1px solid var(--border); border-radius:var(--r); padding:16px; cursor:pointer; transition:border-color 0.12s; display:flex; flex-direction:column; gap:5px; }
.report-card:hover { border-color:var(--accent); }
.report-title { font-size:12.5px; font-weight:700; }
.report-desc { font-size:11.5px; color:var(--text2); line-height:1.5; }
#toast { position:fixed; bottom:18px; right:18px; z-index:9999; background:var(--sb-bg); border:1px solid var(--sb-border); border-radius:var(--r); padding:10px 14px; display:flex; align-items:center; gap:9px; box-shadow:0 4px 16px rgba(0,0,0,0.3); min-width:240px; transform:translateY(70px); opacity:0; transition:all 0.25s ease; color:#e0e8f0; }
#toast.show { transform:translateY(0); opacity:1; }
.toast-icon { font-size:14px; }
.toast-msg { font-size:12px; font-weight:500; flex:1; }
#loader { position:fixed; inset:0; z-index:9000; background:var(--bg); display:none; flex-direction:column; align-items:center; justify-content:center; gap:14px; opacity:0; transition:opacity 0.2s; }
#loader.active { display:flex; }
#loader.visible { opacity:1; }
.loader-ring { width:40px; height:40px; position:relative; }
.loader-ring::before { content:''; position:absolute; inset:0; border-radius:50%; border:2px solid var(--border); }
.loader-ring::after { content:''; position:absolute; inset:0; border-radius:50%; border:2px solid transparent; border-top-color:var(--accent); animation:spin 0.8s linear infinite; }
@keyframes spin { to{transform:rotate(360deg);} }
.loader-logo { font-size:18px; font-weight:800; color:var(--accent); font-family:var(--font); }
.loader-sub { font-size:11.5px; color:var(--text2); }
.loader-steps { display:flex; flex-direction:column; gap:5px; min-width:190px; }
.loader-step { display:flex; align-items:center; gap:7px; font-size:11px; color:var(--text3); padding:5px 9px; border-radius:var(--r); transition:all 0.18s; opacity:0.5; }
.loader-step.done { opacity:1; color:var(--green); }
.loader-step.active { opacity:1; color:var(--text); background:var(--bg3); }
::-webkit-scrollbar { width:4px; height:4px; }
::-webkit-scrollbar-track { background:transparent; }
::-webkit-scrollbar-thumb { background:var(--bg4); border-radius:2px; }
.ai-badge { display:inline-flex; align-items:center; gap:4px; font-size:9px; font-weight:700; padding:2px 7px; border-radius:2px; background:rgba(26,107,74,0.12); border:1px solid rgba(26,107,74,0.28); color:var(--accent); letter-spacing:0.5px; text-transform:uppercase; font-family:var(--mono); }
.ai-scanner-drop { border:2px dashed var(--border2); border-radius:var(--r); padding:28px 20px; text-align:center; cursor:pointer; transition:border-color 0.2s,background 0.2s; background:var(--bg3); position:relative; }
.ai-scanner-drop:hover, .ai-scanner-drop.dragover { border-color:var(--accent); background:var(--accent-lt); }
.ai-scanner-drop input[type=file] { position:absolute; inset:0; opacity:0; cursor:pointer; width:100%; height:100%; }
.ai-result-field { background:var(--accent-mid); border:1px solid rgba(26,107,74,0.3); border-radius:var(--r); padding:8px 11px; font-size:12.5px; font-weight:600; color:var(--text); animation:aiPop 0.3s ease; }
@keyframes aiPop { from{opacity:0;transform:scale(0.97);} to{opacity:1;transform:none;} }
.ai-thinking { display:flex; align-items:center; gap:8px; color:var(--text2); font-size:12px; padding:14px 0; }
.ai-thinking-dots span { display:inline-block; width:5px; height:5px; border-radius:50%; background:var(--accent); animation:dotBounce 1.2s ease-in-out infinite; }
.ai-thinking-dots span:nth-child(2) { animation-delay:0.2s; }
.ai-thinking-dots span:nth-child(3) { animation-delay:0.4s; }
@keyframes dotBounce { 0%,80%,100%{transform:translateY(0);} 40%{transform:translateY(-6px);} }
.reorder-item { display:flex; align-items:center; gap:10px; padding:10px 12px; border:1px solid var(--border); border-radius:var(--r); margin-bottom:6px; background:var(--card); cursor:pointer; transition:border-color 0.12s,box-shadow 0.12s; }
.reorder-item:hover { border-color:var(--accent); box-shadow:0 2px 8px rgba(26,107,74,0.08); }
.reorder-priority { width:5px; flex-shrink:0; align-self:stretch; border-radius:1px 0 0 1px; margin:-10px 4px -10px -12px; }
.ai-cam-preview { width:100%; max-height:180px; object-fit:contain; border-radius:var(--r); border:1px solid var(--border); margin-top:10px; display:none; }
.drug-lookup-wrap { display:flex; gap:8px; align-items:flex-start; }
.drug-lookup-wrap input { flex:1; }
.ai-panel-tab { padding:6px 12px; font-size:12px; font-weight:600; cursor:pointer; color:var(--text2); border-bottom:2px solid transparent; margin-bottom:-1px; transition:color 0.12s; }
.ai-panel-tab.active { color:var(--accent); border-bottom-color:var(--accent); }
tbody tr { animation:rowIn 0.15s ease both; }
@keyframes rowIn { from{opacity:0;transform:translateX(-4px);} to{opacity:1;transform:none;} }
.card { animation:cardIn 0.2s ease both; }
@keyframes cardIn { from{opacity:0;transform:translateY(4px);} to{opacity:1;transform:none;} }
@keyframes rowFade { from{opacity:0;transform:translateX(-4px);} to{opacity:1;transform:none;} }
.bc-tabs { display:flex; border-bottom:1px solid var(--border); margin-bottom:14px; }
.bc-tab { padding:8px 14px; font-size:12px; font-weight:600; cursor:pointer; border-bottom:2px solid transparent; color:var(--text2); transition:all 0.15s; display:flex; align-items:center; gap:5px; }
.bc-tab.active { border-bottom-color:var(--accent); color:var(--accent); }
.bc-tab:hover:not(.active) { color:var(--text); }
.bc-result-banner { padding:10px 14px; border-radius:var(--r); background:rgba(26,107,74,0.07); border:1px solid rgba(26,107,74,0.22); display:flex; align-items:flex-start; gap:10px; margin-top:10px; color:var(--green); font-weight:600; }
/* Camera scan */
.bc-cam-wrap { position:relative; width:100%; border-radius:var(--r); overflow:hidden; background:#000; }
.bc-cam-wrap video { width:100%; display:block; max-height:220px; object-fit:cover; }
.bc-cam-overlay { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; pointer-events:none; }
.bc-reticle { width:70%; max-width:260px; height:80px; border:2px solid var(--accent); border-radius:3px; box-shadow:0 0 0 9999px rgba(0,0,0,0.45); position:relative; }
.bc-reticle::after { content:''; position:absolute; top:50%; left:0; right:0; height:2px; background:linear-gradient(90deg,transparent,var(--accent),transparent); animation:bc-scan 1.8s ease-in-out infinite; }
@keyframes bc-scan { 0%,100%{top:8%;} 50%{top:88%;} }
.bc-corner { position:absolute; width:12px; height:12px; border-color:var(--accent); border-style:solid; }
.bc-corner.tl{top:-2px;left:-2px;border-width:3px 0 0 3px;}
.bc-corner.tr{top:-2px;right:-2px;border-width:3px 3px 0 0;}
.bc-corner.bl{bottom:-2px;left:-2px;border-width:0 0 3px 3px;}
.bc-corner.br{bottom:-2px;right:-2px;border-width:0 3px 3px 0;}
/* Upload drop zone */
.bc-drop { border:2px dashed var(--border2); border-radius:var(--r); padding:22px 16px; text-align:center; cursor:pointer; transition:border-color 0.15s,background 0.15s; background:var(--bg3); position:relative; }
.bc-drop:hover,.bc-drop.drag { border-color:var(--accent); background:var(--accent-lt); }
.bc-drop input[type=file] { position:absolute; inset:0; opacity:0; cursor:pointer; width:100%; height:100%; }
#login-screen { position:fixed; inset:0; z-index:8000; display:flex; align-items:center; justify-content:center; transition:background 0.2s, opacity 0.3s; overflow-y:auto; background:var(--bg); padding:20px; }
#login-screen.hide { opacity:0; pointer-events:none; }
.login-form-panel { display:contents; }

.login-wrap { width:100%; max-width:400px; background:var(--card); border:1px solid var(--border); border-radius:4px; padding:36px 40px; box-shadow:var(--shadow); position:relative; }

.login-logo { margin-bottom:18px; display:flex; align-items:center; gap:8px; }
.login-logo-text { font-size:13px; font-weight:800; color:var(--accent); letter-spacing:-0.2px; }
.login-logo-sub { font-size:10px; color:var(--text3); margin-top:2px; }
.login-title { font-size:20px; font-weight:700; margin-bottom:3px; }
.login-sub { font-size:12px; color:var(--text2); margin-bottom:20px; line-height:1.5; }
.login-field { margin-bottom:12px; }
.login-field label { display:block; font-size:10.5px; font-weight:600; color:var(--text2); letter-spacing:0.2px; margin-bottom:5px; }
.login-inp-wrap { position:relative; }
.login-inp-ico { position:absolute; left:9px; top:50%; transform:translateY(-50%); font-size:13px; pointer-events:none; color:var(--text3); }
.login-inp { width:100%; background:var(--inp); border:1px solid var(--border); border-radius:var(--r); padding:9px 10px 9px 32px; color:var(--text); font-size:13px; font-family:var(--font); outline:none; transition:border-color 0.12s; }
.login-inp:focus { border-color:var(--accent); }
.login-inp.error { border-color:var(--red); }
.login-eye { position:absolute; right:9px; top:50%; transform:translateY(-50%); cursor:pointer; font-size:13px; color:var(--text3); }
.login-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; }
.login-remember { display:flex; align-items:center; gap:5px; font-size:12px; color:var(--text2); cursor:pointer; }
.login-remember input { accent-color:var(--accent); }
.login-forgot { font-size:12px; color:var(--accent); cursor:pointer; font-weight:600; }
.login-btn { width:100%; padding:10px; border-radius:var(--r); border:none; background:var(--accent); color:#fff; font-size:13px; font-weight:700; cursor:pointer; font-family:var(--font); transition:background 0.12s; display:flex; align-items:center; justify-content:center; gap:7px; }
.login-btn:hover { background:var(--accent-dk); }
.login-btn:active { opacity:0.9; }
.login-divider { display:flex; align-items:center; gap:9px; margin:16px 0; color:var(--text3); font-size:11px; }
.login-divider::before, .login-divider::after { content:''; flex:1; height:1px; background:var(--border); }
.login-demo-accounts { display:grid; grid-template-columns:1fr 1fr; gap:6px; }
.demo-acc { padding:8px 10px; border-radius:var(--r); border:1px solid var(--border); background:var(--bg3); cursor:pointer; transition:border-color 0.12s; text-align:center; }
.demo-acc:hover { border-color:var(--accent); }
.demo-acc-role { font-size:10px; font-weight:700; color:var(--accent); text-transform:uppercase; letter-spacing:0.5px; }
.demo-acc-info { font-size:10px; color:var(--text2); margin-top:1px; font-family:var(--mono); }
.login-err { background:rgba(192,57,43,0.06); border:1px solid rgba(192,57,43,0.2); border-radius:var(--r); padding:8px 11px; font-size:12px; color:var(--red); margin-bottom:11px; display:none; }
.login-ok { background:rgba(26,107,74,0.06); border:1px solid rgba(26,107,74,0.2); border-radius:var(--r); padding:8px 11px; font-size:12px; color:var(--green); margin-bottom:11px; display:none; }
.login-err.show, .login-ok.show { display:block; }
.login-shake { animation:shake 0.3s ease; }
@keyframes shake { 0%,100%{transform:translateX(0);} 25%,75%{transform:translateX(-5px);} 50%{transform:translateX(5px);} }
.login-success-overlay { position:absolute; inset:0; background:var(--bg2); border-radius:var(--r); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; opacity:0; pointer-events:none; transition:opacity 0.3s; }
.login-success-overlay.show { opacity:1; }
.login-success-icon { font-size:36px; }
.login-success-text { font-size:15px; font-weight:700; color:var(--green); }
@media(max-width:1200px) { .stats-grid{grid-template-columns:1fr 1fr;} }
@media(max-width:900px) { .grid-2,.grid-3{grid-template-columns:1fr;} }
@media(max-width:700px) { .stats-grid{grid-template-columns:1fr 1fr;} .main{margin-left:0;} .login-wrap{padding:28px 20px;} }
</style>
<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
</head>
<body>

<!-- LOGIN SCREEN -->
<div id="login-screen">
  <div class="login-form-panel">

    <div class="login-wrap">
      <!-- Theme toggle inside card -->
      <button onclick="toggleTheme()" id="login-theme-toggle" title="Toggle Theme" style="position:absolute;top:14px;right:14px;width:28px;height:28px;border-radius:2px;background:var(--bg3);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text2);transition:background 0.12s;z-index:10;">
        <svg id="lt-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg id="lt-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <!-- SIGN IN -->
      <div class="login-card" id="panel-login" style="position:relative;">
        <div class="login-logo">
          <div style="width:30px;height:30px;background:var(--accent);border-radius:2px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg width="16" height="16" viewBox="0 0 18 18" fill="none"><rect x="7" y="1" width="4" height="16" rx="1" fill="white"/><rect x="1" y="7" width="16" height="4" rx="1" fill="white"/></svg>
          </div>
          <div><div class="login-logo-text">MediTrack</div><div class="login-logo-sub">Medicine Management System</div></div>
        </div>
        <div class="login-title">Sign in</div>
        <div class="login-sub">Enter your credentials to access the system.</div>
        <div class="login-err" id="login-err"></div>
        <div class="login-ok" id="login-ok"></div>
        <div class="login-field">
          <label>Email Address</label>
          <div class="login-inp-wrap">
            <span class="login-inp-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span>
            <input type="email" class="login-inp" id="login-email" placeholder="you@example.com" onkeydown="if(event.key==='Enter')doLogin()">
          </div>
        </div>
        <div class="login-field">
          <label>Password</label>
          <div class="login-inp-wrap">
            <span class="login-inp-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
            <input type="password" class="login-inp" id="login-pass" placeholder="Enter your password" onkeydown="if(event.key==='Enter')doLogin()">
            <span class="login-eye" id="login-eye" onclick="togglePass('login-pass','login-eye')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></span>
          </div>
        </div>
        <div class="login-row">
          <label class="login-remember"><input type="checkbox" id="remember-me" checked> Remember me</label>
          <span class="login-forgot" onclick="switchPanel('forgot')">Forgot password?</span>
        </div>
        <button class="login-btn" id="login-btn" onclick="doLogin()"><span id="login-btn-text">Sign In</span></button>
        <div class="login-divider">or use a demo account</div>
        <div class="login-demo-accounts" id="demo-accounts-login"></div>
        <div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--border);text-align:center;">
          <span style="font-size:11.5px;color:var(--text3);">Need an account? </span>
          <span class="login-forgot" onclick="switchPanel('signup')">Create one here</span>
        </div>
        <div class="login-success-overlay" id="login-success">
          <div class="login-success-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div class="login-success-text">Access granted</div>
          <div style="font-size:12px;color:var(--text2);margin-top:4px;">Loading your workspace…</div>
        </div>
      </div>
      <!-- SIGN UP -->
      <div class="login-card" id="panel-signup" style="display:none;position:relative;">
        <div class="login-logo">
          <div style="width:30px;height:30px;background:var(--accent);border-radius:2px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg width="16" height="16" viewBox="0 0 18 18" fill="none"><rect x="7" y="1" width="4" height="16" rx="1" fill="white"/><rect x="1" y="7" width="16" height="4" rx="1" fill="white"/></svg>
          </div>
          <div><div class="login-logo-text">MediTrack</div><div class="login-logo-sub">Create your account</div></div>
        </div>
        <div class="login-title">Create Account</div>
        <div class="login-sub">Fill in the details below. Any email address is accepted.</div>
        <div class="login-err" id="signup-err"></div>
        <div class="login-ok" id="signup-ok"></div>
        <div class="login-field"><label>Full Name</label><div class="login-inp-wrap"><span class="login-inp-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span><input type="text" class="login-inp" id="su-name" placeholder="e.g. Dr. Priya Sharma" onkeydown="if(event.key==='Enter')doSignup()"></div></div>
        <div class="login-field"><label>Email Address</label><div class="login-inp-wrap"><span class="login-inp-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span><input type="email" class="login-inp" id="su-email" placeholder="you@example.com" onkeydown="if(event.key==='Enter')doSignup()"></div></div>
        <div class="login-field"><label>Role</label><div class="login-inp-wrap"><span class="login-inp-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg></span><select class="login-inp" id="su-role" style="padding-left:32px;"><option value="Admin">Admin</option><option value="Pharmacist">Pharmacist</option><option value="Supplier">Supplier</option></select></div></div>
        <div class="login-field"><label>Password</label><div class="login-inp-wrap"><span class="login-inp-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span><input type="password" class="login-inp" id="su-pass" placeholder="Min. 6 characters" onkeydown="if(event.key==='Enter')doSignup()"><span class="login-eye" onclick="togglePass('su-pass','su-eye')" id="su-eye"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></span></div></div>
        <div class="login-field"><label>Confirm Password</label><div class="login-inp-wrap"><span class="login-inp-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span><input type="password" class="login-inp" id="su-pass2" placeholder="Re-enter password" onkeydown="if(event.key==='Enter')doSignup()"><span class="login-eye" onclick="togglePass('su-pass2','su-eye2')" id="su-eye2"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></span></div></div>
        <button class="login-btn" onclick="doSignup()" style="margin-top:6px;">Create Account</button>
        <div style="margin-top:14px;text-align:center;"><span style="font-size:11.5px;color:var(--text3);">Already have an account? </span><span class="login-forgot" onclick="switchPanel('login')">Sign in</span></div>
      </div>
      <!-- FORGOT PASSWORD -->
      <div class="login-card" id="panel-forgot" style="display:none;position:relative;">
        <div class="login-logo">
          <div style="width:30px;height:30px;background:var(--accent);border-radius:2px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg width="16" height="16" viewBox="0 0 18 18" fill="none"><rect x="7" y="1" width="4" height="16" rx="1" fill="white"/><rect x="1" y="7" width="16" height="4" rx="1" fill="white"/></svg>
          </div>
          <div><div class="login-logo-text">MediTrack</div><div class="login-logo-sub">Reset your password</div></div>
        </div>
        <div class="login-title">Reset Password</div>
        <div class="login-sub">Enter your registered email and choose a new password.</div>
        <div class="login-err" id="fp-err"></div>
        <div class="login-ok" id="fp-ok"></div>
        <div class="login-field"><label>Registered Email</label><div class="login-inp-wrap"><span class="login-inp-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span><input type="email" class="login-inp" id="fp-email" placeholder="you@example.com"></div></div>
        <div class="login-field"><label>New Password</label><div class="login-inp-wrap"><span class="login-inp-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span><input type="password" class="login-inp" id="fp-pass" placeholder="Min. 6 characters"><span class="login-eye" onclick="togglePass('fp-pass','fp-eye')" id="fp-eye"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></span></div></div>
        <div class="login-field"><label>Confirm New Password</label><div class="login-inp-wrap"><span class="login-inp-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span><input type="password" class="login-inp" id="fp-pass2" placeholder="Re-enter new password"><span class="login-eye" onclick="togglePass('fp-pass2','fp-eye2')" id="fp-eye2"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></span></div></div>
        <button class="login-btn" onclick="doResetPassword()" style="margin-top:6px;">Update Password</button>
        <div style="margin-top:14px;text-align:center;"><span class="login-forgot" onclick="switchPanel('login')">&larr; Back to sign in</span></div>
      </div>
    </div>
  </div>
</div>

<!-- LOADER -->
<div id="loader">
  <div class="loader-ring"></div>
  <div class="loader-logo">MediTrack</div>
