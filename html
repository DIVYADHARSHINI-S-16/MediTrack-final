function aiScanHandleDrop(e) {
  e.preventDefault(); e.target.closest('.ai-scanner-drop').classList.remove('dragover');
  const file = e.dataTransfer.files[0];
  if (file && file.type.startsWith('image/')) aiScanHandleFile(file);
