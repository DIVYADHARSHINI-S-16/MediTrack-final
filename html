let _userFilter = 'all', _userSearch = '';
function renderUsers() {
  let q = 'SELECT * FROM users';
  const p = [], conds = [];
  if (_userFilter !== 'all') { conds.push('role=?'); p.push(_userFilter); }
  if (_userSearch) { conds.push('(name LIKE ? OR email LIKE ?)'); p.push(`%${_userSearch}%`, `%${_userSearch}%`); }
  if (conds.length) q += ' WHERE ' + conds.join(' AND ');
  const rows = sqlAll(q, p);
  const avatarColors = ['#1a6b4a','#1a55a0','#9a6800','#c0392b','#2e7d6b'];
  document.getElementById('users-tbody').innerHTML = rows.map((u, i) => `
    <tr style="animation-delay:${i*0.04}s;">
      <td><div style="display:flex;align-items:center;gap:10px;">
        <div style="width:32px;height:32px;border-radius:50%;background:${avatarColors[i%5]};display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;color:#fff;flex-shrink:0;">${(u.avatar||u.name[0]).toUpperCase()}</div>
        <strong>${u.name}</strong>
      </div></td>
      <td style="color:var(--text2);">${u.email}</td>
      <td><span class="badge ${u.role==='Admin'?'badge-purple':u.role==='Pharmacist'?'badge-info':'badge-success'}">${u.role}</span></td>
      <td><span class="badge ${u.status==='Active'?'badge-success':'badge-gray'}">${u.status}</span></td>
      <td style="color:var(--text2);font-family:var(--mono);font-size:12px;">${u.phone||'—'}</td>
      <td><div style="display:flex;gap:5px;">
        <button class="btn btn-outline btn-sm" onclick="openModal('editUser',${u.id})"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Edit</button>
        <button class="btn btn-danger btn-sm" onclick="delUser(${u.id})"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M9 6V4h6v2"/></svg></button>
      </div></td>
    </tr>`).join('') || '<tr><td colspan="6" style="text-align:center;padding:32px;color:var(--text2);">No users found</td></tr>';
}
function filterUsers(r, el) {
  _userFilter = r;
  el.parentNode.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  renderUsers();
}
function searchUsers(v) { _userSearch = v; renderUsers(); }
function saveUser() {
  const name = document.getElementById('f-uname').value.trim();
  const email = document.getElementById('f-uemail').value.trim();
  const role = document.getElementById('f-urole').value;
  const phone = document.getElementById('f-uphone').value.trim();
  const status = document.getElementById('f-ustatus').value;
  if (!name || !email) { showToast('Name & email are required', ''); return; }
  const eid = document.getElementById('f-uid')?.value;
  if (eid) { sqlRun('UPDATE users SET name=?,email=?,role=?,phone=?,status=? WHERE id=?', [name,email,role,phone,status,parseInt(eid)]); showToast('User updated', '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'); }
  else { sqlRun('INSERT INTO users(name,email,role,status,phone,avatar) VALUES(?,?,?,?,?,?)', [name,email,role,status,phone,name[0].toUpperCase()]); showToast('User added', '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'); }
  closeModal(); renderUsers();
}
function delUser(id) {
  if (confirm('Delete this user?')) { sqlRun('DELETE FROM users WHERE id=?', [id]); showToast('User deleted', '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M9 6V4h6v2"/></svg>'); renderUsers(); }
}

