function doSignup() {
  const name = document.getElementById('su-name').value.trim();
  const email = document.getElementById('su-email').value.trim().toLowerCase();
  const role = document.getElementById('su-role').value;
  const pass = document.getElementById('su-pass').value;
  const pass2 = document.getElementById('su-pass2').value;
  if (!name) { authMsg('signup-err','Full name is required.',true); shakeCard('panel-signup'); return; }
  if (!email || !email.includes('@')) { authMsg('signup-err','Enter a valid email.',true); shakeCard('panel-signup'); return; }
  if (pass.length < 6) { authMsg('signup-err','Password must be at least 6 characters.',true); shakeCard('panel-signup'); return; }
  if (pass !== pass2) { authMsg('signup-err','Passwords do not match.',true); shakeCard('panel-signup'); return; }
  const accounts = getAccounts();
  if (accounts[email]) { authMsg('signup-err','Email already registered. Sign in instead.',true); shakeCard('panel-signup'); return; }
  accounts[email] = { name, role, pass };
  saveAccounts(accounts);
  authMsg('signup-ok','Account created! Redirecting to sign in...', false);
  setTimeout(() => { document.getElementById('login-email').value = email; document.getElementById('login-pass').value = pass; switchPanel('login'); }, 600);
}

function doLogin() {
  const email = document.getElementById('login-email').value.trim().toLowerCase();
  const pass = document.getElementById('login-pass').value;
  const btn = document.getElementById('login-btn');
  document.getElementById('login-email').classList.remove('error');
  document.getElementById('login-pass').classList.remove('error');
  const loginErr = document.getElementById('login-err');
  if (loginErr) { loginErr.className = 'login-err'; loginErr.textContent = ''; }
  const accounts = getAccounts();
  const acc = accounts[email];
  if (!acc) { authMsg('login-err','No account for this email. Sign up first.',true); document.getElementById('login-email').classList.add('error'); shakeCard('panel-login'); return; }
  if (acc.pass !== pass) { authMsg('login-err','Incorrect password.',true); document.getElementById('login-pass').classList.add('error'); shakeCard('panel-login'); return; }
  currentUser = { email, name:acc.name, role:acc.role };
  btn.disabled = true;
  if (document.getElementById('remember-me').checked) { localStorage.setItem('mt-session', JSON.stringify(currentUser)); }
  else { localStorage.removeItem('mt-session'); }
  document.getElementById('user-name-sb').textContent = currentUser.name;
  document.getElementById('user-role-sb').textContent = currentUser.role;
  document.getElementById('user-avatar-sb').textContent = currentUser.name[0].toUpperCase();
  startApp();
}

function doResetPassword() {
  const email = document.getElementById('fp-email').value.trim().toLowerCase();
