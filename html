// ═══════════════════════════════════════════════
// BATCH STATUS
// ═══════════════════════════════════════════════
function bStatus(expiry, qty, threshold) {
  const today = new Date(), exp = new Date(expiry);
  const diff = Math.ceil((exp - today) / 864e5);
  if (diff < 0) return 'Expired';
  if (diff <= 30) return 'Near Expiry';
  if (threshold && qty < threshold) return 'Low Stock';
  return 'Active';
}

// ═══════════════════════════════════════════════
// ALERTS ENGINE
// ═══════════════════════════════════════════════
function computeAlerts() {
  const batches = sqlAll('SELECT b.*,m.threshold FROM batches b LEFT JOIN medicines m ON b.medicine_id=m.id');
  const today = new Date(), alerts = [];
  batches.forEach(b => {
    const exp = new Date(b.expiry), diff = Math.ceil((exp - today) / 864e5);
    if (diff < 0) {
      alerts.push({ type:'danger', icon:'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>', title:`${b.medicine} — EXPIRED`, desc:`Batch #${b.batch} · ${b.qty} units · Expired ${b.expiry}` });
    } else if (diff <= 7) {
      alerts.push({ type:'danger', icon:'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>', title:`${b.medicine} — Expires in ${diff} day(s)`, desc:`Batch #${b.batch} · ${b.qty} units · Expiry: ${b.expiry}` });
    } else if (diff <= 30) {
      alerts.push({ type:'warning', icon:'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>', title:`${b.medicine} — Expires in ${diff} days`, desc:`Batch #${b.batch} · ${b.qty} units · Expiry: ${b.expiry}` });
    }
    if (b.threshold && b.qty < b.threshold && diff >= 0) {
      alerts.push({ type:'warning', icon:'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>', title:`${b.medicine} — Low Stock`, desc:`Current: ${b.qty} units · Min threshold: ${b.threshold} units` });
    }
  });
  const expiredCount = alerts.filter(a => a.title.includes('EXPIRED')).length;
  const nearCount = alerts.filter(a => a.title.includes('Expires')).length;
  const lowStockCount = alerts.filter(a => a.title.includes('Low Stock')).length;
  const totalCount = alerts.length;
  const badgeEl = document.getElementById('alert-badge');
  if (badgeEl) badgeEl.textContent = totalCount;
  const dot = document.getElementById('notif-dot');
  if (dot) dot.style.display = totalCount > 0 ? 'block' : 'none';
  // Update stat cards
  const setVal = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
  const setBar = (id, pct) => { const el = document.getElementById(id); if (el) el.style.width = pct + '%'; };
  setVal('a-expired', expiredCount);
  setVal('a-near',    nearCount);
  setVal('a-lowstock',lowStockCount);
  setVal('a-total',   totalCount);
  setBar('a-expired-bar',  totalCount > 0 ? Math.round(expiredCount / totalCount * 100) : 0);
  setBar('a-near-bar',     totalCount > 0 ? Math.round(nearCount    / totalCount * 100) : 0);
  setBar('a-lowstock-bar', totalCount > 0 ? Math.round(lowStockCount/ totalCount * 100) : 0);
  return { alerts, expiredCount, nearCount, lowStockCount, totalCount };
}

