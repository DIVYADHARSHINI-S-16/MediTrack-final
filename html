  const pass2 = document.getElementById('fp-pass2').value;
  if (!email) { authMsg('fp-err','Enter your registered email.',true); shakeCard('panel-forgot'); return; }
  if (pass.length < 6) { authMsg('fp-err','New password must be at least 6 characters.',true); shakeCard('panel-forgot'); return; }
  if (pass !== pass2) { authMsg('fp-err','Passwords do not match.',true); shakeCard('panel-forgot'); return; }
  const accounts = getAccounts();
  if (!accounts[email]) { authMsg('fp-err','No account found with this email.',true); shakeCard('panel-forgot'); return; }
  accounts[email].pass = pass;
  saveAccounts(accounts);
  authMsg('fp-ok','Password updated! You can now sign in.', false);
  setTimeout(() => { document.getElementById('login-email').value = email; document.getElementById('login-pass').value = pass; switchPanel('login'); }, 700);
}

